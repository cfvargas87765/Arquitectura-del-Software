        <UserObject label="" plantUmlData="{&#xa;  &quot;data&quot;: &quot;@startuml\ntitle Figura 5. Vista física de despliegue del Sistema de Gestión de Coworking\n\ntop to bottom direction\n\nskinparam componentStyle rectangle\nskinparam shadowing false\nskinparam packageStyle rectangle\nskinparam defaultTextAlignment center\nskinparam linetype ortho\n\nactor Usuario\n\nnode \&quot;Internet\&quot; {\n\n    node \&quot;Azure Application Gateway\&quot; as AppGateway\n\n    package \&quot;Azure App Service\&quot; {\n\n        component \&quot;Usuarios\&quot; as Usuarios\n        component \&quot;Membresías\&quot; as Membresias\n        component \&quot;Reservas\&quot; as Reservas\n        component \&quot;Control de Acceso\&quot; as Acceso\n        component \&quot;Facturación\&quot; as Facturacion\n        component \&quot;Pagos\&quot; as Pagos\n        component \&quot;Notificaciones\&quot; as Notificaciones\n    }\n\n    queue \&quot;Azure Service Bus\&quot; as ServiceBus\n\n    database \&quot;Azure SQL Database\&quot; as SQLDB\n\n    component \&quot;Azure Key Vault\&quot; as KeyVault\n\n    component \&quot;Azure Monitor\\nApplication Insights\&quot; as Monitor\n}\n\ncloud \&quot;Pasarela de Pagos\&quot; as Pasarela\ncloud \&quot;Proveedor de Notificaciones\&quot; as Proveedor\n\nUsuario --&gt; AppGateway : HTTPS\n\nAppGateway --&gt; Usuarios\nAppGateway --&gt; Membresias\nAppGateway --&gt; Reservas\nAppGateway --&gt; Acceso\n\nReservas --&gt; SQLDB\nMembresias --&gt; SQLDB\nUsuarios --&gt; SQLDB\nAcceso --&gt; SQLDB\nFacturacion --&gt; SQLDB\nPagos --&gt; SQLDB\n\nReservas --&gt; ServiceBus\nMembresias --&gt; ServiceBus\nPagos --&gt; ServiceBus\n\nServiceBus --&gt; Notificaciones\n\nPagos --&gt; Pasarela\nNotificaciones --&gt; Proveedor\n\nUsuarios --&gt; KeyVault\nMembresias --&gt; KeyVault\nReservas --&gt; KeyVault\nAcceso --&gt; KeyVault\nFacturacion --&gt; KeyVault\nPagos --&gt; KeyVault\nNotificaciones --&gt; KeyVault\n\nUsuarios --&gt; Monitor\nMembresias --&gt; Monitor\nReservas --&gt; Monitor\nAcceso --&gt; Monitor\nFacturacion --&gt; Monitor\nPagos --&gt; Monitor\nNotificaciones --&gt; Monitor\n\n@enduml&quot;,&#xa;  &quot;config&quot;: null&#xa;}" id="C74IXg2VIhBm6YT5jxl3-1">
