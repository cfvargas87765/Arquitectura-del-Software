        <UserObject label="" plantUmlData="{&#xa;  &quot;data&quot;: &quot;@startuml\ntitle Figura 4. Vista de desarrollo del Sistema de Gestión de Coworking\n\ntop to bottom direction\n\nskinparam componentStyle rectangle\nskinparam packageStyle rectangle\nskinparam shadowing false\nskinparam defaultTextAlignment center\n\npackage \&quot;Repositorios de servicios\&quot; {\n\n    component \&quot;coworking-users-service\&quot; as Users\n    component \&quot;coworking-memberships-service\&quot; as Memberships\n    component \&quot;coworking-reservations-service\&quot; as Reservations\n    component \&quot;coworking-access-service\&quot; as Access\n    component \&quot;coworking-billing-service\&quot; as Billing\n    component \&quot;coworking-payments-service\&quot; as Payments\n    component \&quot;coworking-notifications-service\&quot; as Notifications\n}\n\nartifact \&quot;Contratos API\\n(OpenAPI / JSON)\&quot; as Contracts\n\ncomponent \&quot;Integración Continua\\n(CI/CD)\&quot; as Pipeline\n\nUsers --&gt; Contracts\nMemberships --&gt; Contracts\nReservations --&gt; Contracts\nAccess --&gt; Contracts\nBilling --&gt; Contracts\nPayments --&gt; Contracts\nNotifications --&gt; Contracts\n\nContracts --&gt; Pipeline\n\nnote bottom\nCada servicio mantiene código fuente,\npruebas, configuración y versionamiento\nde forma independiente.\nend note\n\n@enduml&quot;,&#xa;  &quot;config&quot;: null&#xa;}" id="q1hj3uOIixSySkRZ1E_Z-1">
